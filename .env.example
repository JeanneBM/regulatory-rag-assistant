# Environment variables read by `regrag`. This file is a template and is not loaded
# automatically. After `azd up`, `azd env get-values` prints the deployed values.
# Azure calls use Microsoft Entra ID (`az login` locally); no keys are needed.

# local: TF-IDF over a corpus downloaded to .local/ (no cloud resources)
# azure: Azure AI Search hybrid retrieval
REGRAG_BACKEND=local

AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# Optional: a separate deployment for claim verification (defaults to the chat deployment)
AZURE_OPENAI_VERIFIER_DEPLOYMENT=

AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_ALIAS=regrag
AZURE_SEARCH_SEMANTIC_RANKER=true

AZURE_STORAGE_ACCOUNT_URL=https://YOURACCOUNT.blob.core.windows.net/
AZURE_STORAGE_CONTAINER=corpus

# strict: return only claims the verifier labels "supported"; lenient: also "partial"
REGRAG_CLAIM_POLICY=strict
REGRAG_VERIFY_CLAIMS=true
REGRAG_MIN_RERANKER_SCORE=1.2
REGRAG_TOP_K=8
